+         mask-image:linear-gradient(to top,#000 0%,rgba(0,0,0,.78) calc(12% * var(--refl-k,1)),rgba(0,0,0,.34) calc(34% * var(--refl-k,1)),rgba(0,0,0,.12) calc(56% * var(--refl-k,1)),transparent calc(74% * var(--refl-k,1)))}
